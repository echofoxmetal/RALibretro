[submodule "src/SDL2"]
	path = src/SDL2
	url = https://github.com/RetroAchievements/SDL2
[submodule "src/jsonsax"]
	path = src/jsonsax
	url = https://github.com/leiradel/jsonsax
[submodule "src/miniz"]
	path = src/miniz
	url = https://github.com/richgel999/miniz.git
	ignore = untracked
[submodule "src/RAInterface"]
	path = src/RAInterface
	url = https://github.com/echofoxmetal/RAInterface.git
	branch = master
[submodule "src/rcheevos"]
	path = src/rcheevos
	url = https://github.com/RetroAchievements/rcheevos.git
[submodule "src/libchdr"]
	path = src/libchdr
	url = https://github.com/rtissera/libchdr.git
	ignore = untracked


